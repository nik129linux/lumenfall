    const out = [];
    g.pipeline.scene.traverse((o) => {
      if (!o.isMesh) return;
      const m = o.material;
      if (!m || Array.isArray(m)) return;
      const img = m.map && m.map.image;
      const e = o.matrixWorld.elements;
      out.push({
        vis: o.visible, blend: m.blending, op: +(m.opacity ?? 1).toFixed(2),
        tex: img ? `${img.width}x${img.height}` : (m.map ? 'map-noimg' : '-'),
        mag: m.map ? m.map.magFilter : '-',
        scale: `${Math.round(o.scale.x)}x${Math.round(o.scale.y)}`,
        wpos: `${Math.round(e[12])},${Math.round(e[13])}`,
        order: o.renderOrder, z: Math.round(o.position.z),
      });
    });
    return out;
  });
