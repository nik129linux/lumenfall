import { chromium } from 'playwright';
const b = await chromium.launch({args:['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox']});
const p = await b.newPage({viewport:{width:960,height:540}});
const errs=new Set();
p.on('pageerror',e=>errs.add(e.message));
p.on('console',m=>{ if(m.type()==='error') errs.add('console: '+m.text().slice(0,200)); });
await p.goto('http://localhost:8765/index.html',{waitUntil:'load'});
await p.waitForFunction(()=>window.__lumenfall?.machine?.state==='menu',null,{timeout:20000});
await p.click('#menu-new');
await p.waitForTimeout(1000);
for (let i=0;i<10;i++){ await p.keyboard.press('Enter'); await p.waitForTimeout(120); await p.keyboard.press('Enter'); await p.waitForTimeout(120);}
await p.waitForFunction(()=>window.__lumenfall.machine.state==='play',null,{timeout:10000});

// Simulate a real player: hold right, jump periodically, attack, dash.
const r = await p.evaluate(async ()=>{
  const g=window.__lumenfall;
  const log=[];
  const start={x:g.player.body.x, y:g.player.body.y};
  let maxX=start.x, deaths=0, jumps=0, dashes=0, attacks=0, hits=0;
  const input=g.input;
  for (let i=0;i<1800;i++){
    // drive the virtual input directly
    input.down.add('KeyD');
    if (i%37===0){ input.buffer.set('jump',0.12); jumps++; }
    if (i%211===0){ input.buffer.set('dash',0.12); dashes++; }
    if (i%97===0){ input.buffer.set('attack',0.12); attacks++; }
    await new Promise(res=>requestAnimationFrame(res));
    maxX=Math.max(maxX,g.player.body.x);
    if (g.machine.state==='dead'){ deaths++; 
      // respawn via the death path
      g.retryLevel();
      await new Promise(res=>setTimeout(res,120));
      i--; continue;
    }
    if (i%600===0) log.push({i, x:Math.round(g.player.body.x), y:Math.round(g.player.body.y), ember:g.ember, state:g.machine.state, enemies:g.enemies.length});
  }
  input.down.delete('KeyD');
  return {start, maxX:Math.round(maxX), travelled:Math.round(maxX-start.x),
          levelWidth:g.level.worldWidth, deaths, jumps, dashes, attacks, log,
          ember:g.ember, bossAwake:g.bossAwake, finalState:g.machine.state};
});
console.log(JSON.stringify(r,null,1));
console.log('errors:', errs.size ? [...errs] : 'none');
await p.screenshot({path:'.scratch/shots/G-playthrough.png'});
await b.close();
