import os,re
bad=[]
for root,_,files in os.walk('js'):
    for f in files:
        if not f.endswith('.js') or 'vendor' in root: continue
        p=os.path.join(root,f)
        for i,l in enumerate(open(p,encoding='utf-8'),1):
            m=re.match(r"\s*import\s+(?:\{([^}]*)\}|(\*\s+as\s+\w+))?\s*from\s+'([^']+)'",l)
            if not m: continue
            names=[n.strip() for n in (m.group(1) or '').split(',') if n.strip()]
            if m.group(2): names.append(m.group(2).split('as')[-1].strip())
            s=m.group(3)
            if not s.startswith('.'): continue
            t=os.path.normpath(os.path.join(root,s))
            if not os.path.isfile(t): bad.append(f"{p}:{1} MISSING FILE {s}"); continue
            src=open(t,encoding='utf-8').read()
            for n in names:
                local=n.split(' as ')[-1].strip()
