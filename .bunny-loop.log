import json
from PIL import Image
m=json.load(open('assets/atlases/manifest.json'))
def grid(name, S=6, cols=8):
    d=m[name]; cw,ch=d['cell']
    a=Image.open(f'assets/atlases/{name}.png').convert('RGBA')
    order=[]
    for clip,fr in d['frames'].items():
        for i,f in enumerate(fr): order.append((clip,i,f))
    rows=(len(order)+cols-1)//cols
    W=cols*(cw*S+8)+8; H=rows*(ch*S+8)+8
    c=Image.new('RGBA',(W,H),(128,128,128,255))
    for n,(clip,i,(x,y)) in enumerate(order):
        r,col=divmod(n,cols)
        f=a.crop((x,y,x+cw,y+ch)).resize((cw*S,ch*S),Image.NEAREST)
        c.alpha_composite(f,(8+col*(cw*S+8), 8+r*(ch*S+8)))
    c.save(f'.scratch/stage1/grid-{name}.png'); print(name, c.size, len(order),'frames')
grid('kael'); grid('statue', S=4, cols=6)
