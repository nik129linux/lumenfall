    vertexShader: VERT,
    fragmentShader: FRAG,
    transparent: true,
    depthWrite: false,
    depthTest: false,
  });
  mat.userData.uniforms = uniforms;
  return mat;
}

'''
s = s[:mk_start] + new_mk + s[mk_end:]

