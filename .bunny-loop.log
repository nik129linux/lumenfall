  g.pipeline.scene.traverse(o => {
    if (!o.isMesh) return;
    const wp = new (o.position.constructor)(); o.getWorldPosition(wp);
    const s = o.scale;
    const near = Math.abs(wp.x - sp.x) < 260 && Math.abs(wp.y - sp.y) < 90;
    if (near) out.meshes.push({
      type: o.material?.type, geo: `${o.geometry?.parameters?.width}x${o.geometry?.parameters?.height}`,
      scale: `${s.x.toFixed(2)},${s.y.toFixed(2)}`, ro: o.renderOrder,
      pos: `${wp.x.toFixed(0)},${wp.y.toFixed(0)}`,
      color: o.material?.color?.getHexString?.() ?? null,
      blending: o.material?.blending,
      spriteChild: !!o.parent?.userData?.minionChild,
    });
  });
  return out;
});
console.log(JSON.stringify(info, null, 1));
await browser.close();
