    bg = np.asarray(im.filter(ImageFilter.BoxBlur(radius)), dtype=np.float64)
    px = im.load()
    out = []
    for y in range(H):
        for x in range(W):
            c = px[x, y]
            d = max(abs(c[i] - bg[y, x, i]) for i in range(3))
            out.append((1.0 if d > thresh else 0.0, c))
    return out


'''
