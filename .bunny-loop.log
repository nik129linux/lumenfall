import { chromium } from 'playwright';
const b = await chromium.launch({args:['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox']});
const p = await b.newPage({viewport:{width:960,height:540}});
p.on('pageerror',e=>console.log('[err]',e.message));
await p.goto('http://localhost:8765/index.html',{waitUntil:'load'});
await p.waitForFunction(()=>window.__lumenfall?.machine?.state==='menu',null,{timeout:20000});
await p.evaluate(async ()=>{
  const g=window.__lumenfall;
  g.ui.hideAll(); g._loadLevel(0,{silent:true});
  g.cutscene.active=false; g.machine.state='play'; g.ui.showHud();
  g.player.body.x=700; g.player.body.y=40;
  await new Promise(r=>setTimeout(r,900));
});
await p.waitForTimeout(600);
console.log(JSON.stringify(await p.evaluate(()=>{
  const g=window.__lumenfall, W=480,H=270;
  g.pipeline.render();
  const bf=new Uint8Array(W*H*4);
  g.renderer.readRenderTargetPixels(g.pipeline.target,0,0,W,H,bf);
  const at=(x,y)=>{const i=(y*W+x)*4;return [bf[i],bf[i+1],bf[i+2]];};
  // sample backdrop-only rows (skip tiles/sprites): use rows well above the playfield
  let sum=0,n=0,bright=0;
  for(let y=100;y<200;y+=3) for(let x=0;x<W;x+=3){
    const c=at(x,y); const v=(c[0]+c[1]+c[2])/3; sum+=v; n++; if(v>110) bright++;
  }
  // and the same after the sRGB encode the post pass applies
  const enc=(v)=>{v/=255; return v<=0.04045? v*12.92*255 : (Math.pow((v+0.055)/1.055,2.4))*255;};
  return { bufferMean:Math.round(sum/n), pctBright:+(100*bright/n).toFixed(1),
           afterEncodeMean: Math.round(enc(sum/n)) };
}),null,1));
await b.close();
