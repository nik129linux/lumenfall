# content map: is the pixel "not background"?
def content_mask(im, mode):
    W,H = im.size
    px = im.convert('RGB').load()
    m = [[0]*W for _ in range(H)]
    for y in range(H):
        for x in range(W):
            r,g,b = px[x,y]
            if mode=='magenta':
                # distance to magenta
                d = ((r-255)**2 + g**2 + (b-255)**2) ** 0.5
                m[y][x] = 0 if d < 90 else 1
            else:
                h,l,s = colorsys.rgb_to_hls(r/255,g/255,b/255)
                lum = 0.299*r+0.587*g+0.114*b
                # background: very dark OR near-black; creature: brown/green brighter
                m[y][x] = 0 if (lum < 26 or (lum < 40 and s < 0.35)) else 1
    return m

