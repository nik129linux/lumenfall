import numpy as np
from PIL import Image
from scipy import ndimage
a=np.asarray(Image.open('assets/statue.jpeg').convert('RGB')).astype(np.float32)
def flood(sub,tol=28):
    ring=np.concatenate([sub[0,:],sub[-1,:],sub[:,0],sub[:,-1]],axis=0)
    ref=np.median(ring,axis=0)
    d=np.sqrt(((sub-ref)**2).sum(axis=2))
    lab,n=ndimage.label(d<=tol)
    border=set(lab[0,:])|set(lab[-1,:])|set(lab[:,0])|set(lab[:,-1]); border.discard(0)
    return ~np.isin(lab,list(border)) if border else d>tol
# explicit pose boxes from the board's actual layout
boxes=[(20,136,135,394),(133,136,252,394),(248,136,362,394),(358,136,474,394),
       (483,136,620,394),(610,136,749,394),(740,136,877,394),(872,136,1006,394),
       (996,136,1134,394),(1124,136,1263,394),(1253,136,1391,394),(1381,136,1520,394)]
print('pose  fg%   left/right fg%   verdict')
for i,(x0,y0,x1,y1) in enumerate(boxes):
    m=flood(a[y0:y1,x0:x1])
    L=m[:,:4].mean(); R=m[:,-4:].mean()
    ok = m.mean()>0.15 and L<0.10 and R<0.10
    print(f'  {i+1:2d} {m.mean():.2f}   {L:.2f}/{R:.2f}  {"OK" if ok else "BLEED"}')
