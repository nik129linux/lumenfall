import importlib.util, numpy as np, colorsys
from PIL import Image
spec = importlib.util.spec_from_file_location('cm','tools/cut_minions.py')
cm = importlib.util.module_from_spec(spec); spec.loader.exec_module(cm)
im = Image.open('assets/crawler.png').convert('RGB'); W,H = im.size; px = im.load()
# frame 0 box from the current pipeline
lc = cm.local_contrast_alpha(im, W, H)
solid = [[lc[y*W+x][0] > 0.5 for x in range(W)] for y in range(H)]
sep = [sum(1 for x in range(W) if solid[y][x]) < W*0.02 for y in range(H)]
rows = [r for r in cm.bands([not f for f in sep], W, H) if r[1]-r[0] > H*0.05]
wt = lambda r: sum(1 for y in range(r[0],r[1]+1) for x in range(W) if solid[y][x])
top = max(wt(r) for r in rows); rows=[r for r in rows if wt(r)>top*0.15]
y0,y1 = rows[0]
colflags=[all(not solid[y][x] for y in range(y0,y1+1)) for x in range(W)]
boxes = cm.merge_fragments(cm.split_row(colflags))
x0,x1 = boxes[0]
bw,bh = x1-x0+1, y1-y0+1
print('frame0 box', bw, 'x', bh)

def bgmask(tol_luma=28, tol_sat=0.35):
    m=[[False]*bw for _ in range(bh)]
    for yy in range(bh):
        for xx in range(bw):
            r,g,b = px[x0+xx, y0+yy]
            lum = 0.299*r+0.587*g+0.114*b
            _,_,s = colorsys.rgb_to_hls(r/255,g/255,b/255)
            m[yy][xx] = (lum < tol_luma) and (s < tol_sat)
    return m

for tol in (28, 45):
    bg = bgmask(tol, 0.35)
    bg = cm.fill_holes(bg, bw, bh)      # bg pockets enclosed by creature = creature
    fg = [[not v for v in row] for row in bg]
    fg = cm.close_mask(fg, bw, bh, 1)
    keep = cm.largest_component(fg, bw, bh)
    # does the body survive?
    cov = sum(1 for y in range(bh) for x in range(bw) if keep[y][x])
    # column profile: legs reaching the box edge?
    touch_left  = sum(1 for y in range(bh) if keep[y][0])
    touch_right = sum(1 for y in range(bh) if keep[y][bw-1])
    touch_top   = sum(1 for x in range(bw) if keep[0][x])
    print(f'  luma<{tol}: fg coverage {cov/(bw*bh):.1%}  edge-touch rows L={touch_left} R={touch_right} top={touch_top}')
