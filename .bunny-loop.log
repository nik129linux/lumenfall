import numpy as np
from PIL import Image
from scipy import ndimage
def key(a):
    r,g,b = a[...,0],a[...,1],a[...,2]
    # chroma distance to pure magenta
    d = np.sqrt((r-255)**2 + g**2 + (b-255)**2)
    return d > 60
for name in ['kael','goodwitch','badwitch','demon']:
    a=np.asarray(Image.open(f'assets/{name}.jpeg').convert('RGB')).astype(np.float32)
    fg=key(a)
    lab,n=ndimage.label(fg)
    sizes=ndimage.sum(fg,lab,range(1,n+1))
    objs=ndimage.find_objects(lab)
    items=[]
    for i,s in enumerate(sizes):
        if s<1500: continue
        sl=objs[i]
        items.append((sl[1].start, sl[0].start, sl[0].stop, sl[1].stop, int(s)))
    # group into rows by y-centre
    items.sort(key=lambda t:t[1])
    rows=[]
    for it in items:
        cy=(it[1]+it[2])/2
        for r in rows:
            if abs(cy-r[0])<70: r[1].append(it); r[0]=(r[0]*(len(r[1])-1)+cy)/len(r[1]); break
        else: rows.append([cy,[it]])
    rows.sort(key=lambda r:r[0])
    print(f'== {name}: {len(items)} comps')
    for cy,its in rows:
        its.sort(key=lambda t:t[0])
        ys=min(i[1] for i in its); ye=max(i[2] for i in its)
        print(f'   row y{ys:4d}-{ye:4d}  n={len(its)}  x={[i[0] for i in its]}')
