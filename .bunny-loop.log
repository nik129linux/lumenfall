import { chromium } from 'playwright';
const b = await chromium.launch({args:['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox']});
const p = await b.newPage({viewport:{width:960,height:540}});
p.on('pageerror',e=>console.log('[err]',e.message));
await p.goto('http://localhost:8765/index.html?level=1',{waitUntil:'load'});
await p.waitForTimeout(2500);
for (const v of [0x4a4a4a, 0x383838, 0x2a2a2a, 0x202020]) {
  const r = await p.evaluate((hex)=>{
    const g=window.__lumenfall, W=480,H=270;
    g.parallax.layers[0].mesh.material.color.setHex(hex);
    g.pipeline.render();
    const bf=new Uint8Array(W*H*4);
    g.renderer.readRenderTargetPixels(g.pipeline.target,0,0,W,H,bf);
    const at=(x,y)=>{const i=(y*W+x)*4;return [bf[i],bf[i+1],bf[i+2]];};
    // emulate the post pass sRGB encode to get the on-screen value
    const enc=(c)=>{const v=c/255; return Math.round((v<=0.04045? v*12.92 : Math.pow((v+0.055)/1.055,2.4))*255);};
