out=[]
for name,(f,y0,y1) in crops.items():
    im=Image.open(f).convert('RGB')
    W,H=im.size
    top=int(H*y0); bot=int(H*y1); h=bot-top
    # centre-crop to 16:9
    tw=int(round(h*16/9))
    if tw>W:
        left=0; right=W
    else:
        left=(W-tw)//2; right=left+tw
    c=im.crop((left,top,right,bot))
    print(name,f,'src',im.size,'-> crop',c.size,'aspect %.3f'%(c.width/c.height))
    out.append(c.resize((600,338), Image.LANCZOS))
sheet=Image.new('RGB',(600,338*len(out)+8*len(out)),(20,20,20))
for i,c in enumerate(out): sheet.paste(c,(0,i*(338+8)))
sheet.save('.scratch/stage1b/crop-preview.png')
print('saved preview', sheet.size)
