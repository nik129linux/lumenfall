  g._syncPlayerToWorld();
  g.cam.x = b.x - 200; g.cam.y = b.y - 90; g._updateCamera(0.016, true);
});
await new Promise(r=>setTimeout(r,900));
await page.screenshot({ path: `${OUT}/l2-column.png` });
console.log('l2-column:', await page.evaluate(() => {
  const b = window.__lumenfall.player.body;
  return `player tile ${Math.floor(b.cx/8)} y=${Math.round(b.y)} onGround=${b.onGround} (step top 72, column top 112)`;
}));

// ---- 2. the pit fall-out flash/fade frame, in an L1 hole
await page.goto(`${URL}?level=1`, { waitUntil: 'load' });
await page.waitForFunction(() => ['play','boss'].includes(window.__lumenfall?.machine?.state), { timeout: 20000 });
await new Promise(r=>setTimeout(r,600));
await page.evaluate(() => {
  const d = window.__lumenfall.level.data, h = d.holes[0];
  const b = window.__lumenfall.player.body;
  b.vx = 0; b.vy = -140; b.x = (h[0] + 4) * 8 + 1; b.y = 22; b.onGround = false;
  window.__lumenfall.cam.x = b.x - 240;
});
// Catch it while the red flash is up and the fade is under way.
let shot = false;
for (let i = 0; i < 400 && !shot; i++) {
  await new Promise(r=>requestAnimationFrame(r));
  const u = await page.evaluate(() => {
    const g = window.__lumenfall;
    return { hurt: g.pipeline.postUniforms.hurt.value, fade: g.pipeline.postUniforms.fade.value, dead: g.player.dead };
  });
  if (u.dead && u.fade < 0.97 && u.fade > 0.3) { await page.screenshot({ path: `${OUT}/pit-death.png` }); shot = true;
    console.log(`pit-death: captured at fade=${u.fade.toFixed(2)} hurt=${u.hurt.toFixed(2)}`); }
}
if (!shot) { await page.screenshot({ path: `${OUT}/pit-death.png` }); console.log('pit-death: fell back to an unmetered frame'); }

// ---- 3. L2 hint toast + rune
await page.goto(`${URL}?level=2`, { waitUntil: 'load' });
await page.waitForFunction(() => ['play','boss'].includes(window.__lumenfall?.machine?.state), { timeout: 20000 });
