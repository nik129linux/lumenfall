+}
+/* Slow push in over the time a panel is on screen, alternating side so
+   consecutive panels do not drift the same way. */
+.panel-layer .panel-img,
+.panel-layer .panel-bg {
+  transition: transform 6.5s cubic-bezier(.16,1,.3,1), opacity .4s linear;
+  transform: scale(1);
+  transform-origin: 50% 50%;
+}
+.panel-layer.origin-left .panel-img,
+.panel-layer.origin-left .panel-bg { transform-origin: 0% 50%; }
