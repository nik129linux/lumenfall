  const g=window.__lumenfall;
  const W=480,H=270;
  const buf=new Uint8Array(W*H*4);
  g.renderer.readRenderTargetPixels(g.pipeline.target,0,0,W,H,buf);
  // find brightest rows and the player region
  const rows=[];
  for(let y=0;y<H;y++){ let s=0; for(let x=0;x<W;x++){const i=(y*W+x)*4; s+=buf[i]+buf[i+1]+buf[i+2];} rows.push({y,avg:Math.round(s/W/3)}); }
  rows.sort((a,b)=>b.avg-a.avg);
  const pl=g.player;
  const bx=Math.round(pl.mesh.position.x-g.cam.x), by=Math.round(pl.mesh.position.y-g.cam.y);
  const sample=(x,y)=>{const i=((H-1-y)*W+x)*4; return [buf[i],buf[i+1],buf[i+2]];};
  return {topRows:rows.slice(0,6), playerBuf:[bx,by], playerPixel:sample(bx+24,by+20),
          floorPixel: sample(100, 31), midPixel: sample(240,150), topPixel:sample(240,250),
          lipCount: g.level.tilesGroup.children.length};
});
console.log(JSON.stringify(r,null,1));
await b.close();
