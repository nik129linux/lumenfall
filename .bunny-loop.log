from PIL import Image

def sim(src, S, posx, posy, out, scale=4):
    """A 96x96 box with background-size:S px and background-position:posx posy
    shows the image region from (-posx, -posy) to (-posx+96, -posy+96)."""
    im = Image.open(f'assets/cutscenes/{src}.png')
    k = 1024.0 / S
    x0, y0 = round(-posx * k), round(-posy * k)
    c = im.crop((x0, y0, x0 + round(96 * k), y0 + round(96 * k)))
    c.resize((96 * scale, 96 * scale), Image.LANCZOS).save(out)
    return (x0, y0, c.size), f'x {x0/1024*100:.0f}%-{(x0+96*k)/1024*100:.0f}%, y {y0/1024*100:.0f}%-{(y0+96*k)/1024*100:.0f}%'

