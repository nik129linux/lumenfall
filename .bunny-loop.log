const OUT = '.scratch/stage2d';
fs.mkdirSync(OUT, { recursive: true });
const errors = [];
const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox'] });
const page = await browser.newPage({ viewport: { width: 960, height: 540 } });
page.on('console', m => { if (m.type()==='error') errors.push(m.text()); });
page.on('pageerror', e => errors.push('pageerror: '+e.message));
page.on('requestfailed', r => errors.push('reqfail: '+r.url()));
const state = () => page.evaluate(() => window.__lumenfall.machine.state);

// The four panels this stage adds: 07 and 08 and 09 in the deal, 10 in the theft.
const WANT = { deal: ['07','08','09'], theft: ['10'] };

await page.goto(`${URL}`, { waitUntil: 'load' });
await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'menu', { timeout: 25000 });
await page.click('#menu-new');
await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'cutscene', { timeout: 20000 });
await new Promise(r=>setTimeout(r,300));
await page.keyboard.press('Escape');
await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'play', { timeout: 20000 });
await new Promise(r=>setTimeout(r,400));

// walk to the elder
await page.keyboard.down('ArrowRight');
await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'story', { timeout: 20000 }).then(()=>true,()=>false);
await page.keyboard.up('ArrowRight');
await new Promise(r=>setTimeout(r,1200));

const got = {};
const readDeal = () => page.evaluate(() => ({
  art: document.getElementById('story-panel').dataset.art || '',
  speaker: document.getElementById('story-speaker').textContent,
  line: document.getElementById('story-line').textContent,
  typing: !document.getElementById('story-line').classList.contains('done'),
  src: (document.querySelector('#story-panel .panel-layer.on .panel-img')?.getAttribute('src') || ''),
}));

// Advance until each wanted panel has been captured.
for (let guard = 0; guard < 24 && Object.keys(got).length < 3; guard++) {
  const d = await readDeal();
  if (d.art && WANT.deal.includes(d.art) && !got[d.art]) {
    // let the line finish so the text is whole in the frame
    for (let i = 0; i < 12 && d.typing; i++) { await new Promise(r=>setTimeout(r,120)); Object.assign(d, await readDeal()); }
    await page.screenshot({ path: `${OUT}/panel-${d.art}.png` });
    got[d.art] = d;
    console.log(`panel-${d.art}: speaker="${d.speaker}" line="${d.line.slice(0,44)}..." src=${d.src}`);
  }
  await page.keyboard.press('KeyZ');
  await new Promise(r=>setTimeout(r,220));
  await page.keyboard.press('KeyZ');
  await new Promise(r=>setTimeout(r,420));
}

// finish the deal, then capture panel 10 in the theft
for (let i = 0; i < 10 && (await state()) === 'story'; i++) {
  await page.keyboard.press('KeyZ'); await new Promise(r=>setTimeout(r,200));
  await page.keyboard.press('KeyZ'); await new Promise(r=>setTimeout(r,380));
}
await page.waitForFunction(() => window.__lumenfall?.cutscene?.active, { timeout: 15000 }).then(()=>true,()=>false);
for (let guard = 0; guard < 12 && !got['10']; guard++) {
  const d = await page.evaluate(() => ({
    art: document.getElementById('panel-art').dataset.art || '',
    title: document.getElementById('cut-title').textContent,
    line: document.getElementById('type-line').textContent,
    done: document.getElementById('type-line').classList.contains('done'),
    src: (document.querySelector('#panel-art .panel-layer.on .panel-img')?.getAttribute('src') || ''),
  }));
  if (d.art === '10' && !got['10']) {
    for (let i = 0; i < 12 && !d.done; i++) { await new Promise(r=>setTimeout(r,120)); Object.assign(d, await page.evaluate(() => ({
      done: document.getElementById('type-line').classList.contains('done'),
      line: document.getElementById('type-line').textContent }))); }
    await page.screenshot({ path: `${OUT}/panel-10.png` });
    got['10'] = d;
    console.log(`panel-10: title="${d.title}" line="${d.line.slice(0,44)}..." src=${d.src}`);
  }
  await page.keyboard.press('KeyZ');
  await new Promise(r=>setTimeout(r,650));
}
console.log('captured:', Object.keys(got).sort().join(' '), '| missing:', ['07','08','09','10'].filter(x=>!got[x]).join(' ')||'none');
console.log('console errors:', errors.length, errors.slice(0,3));
await browser.close();
