from PIL import Image, ImageDraw

def sim(src, S, px, py, out, scale=4):
    """Exactly what a 96x96 box shows for background-size:S px / position:px py."""
    im = Image.open(f'assets/cutscenes/{src}.png')
    k = 1024.0 / S
    c = im.crop((round(px*k), round(py*k), round(px*k)+round(96*k), round(py*k)+round(96*k)))
    c.resize((96*scale, 96*scale), Image.LANCZOS).save(out)
