[0m$ [0mcd "/home/nico/Documents/U/Co/U/4s/courses/interfaces/tareas/proyecto final/juego" && mkdir -p .scratch/stage2b && cat > .scratch/stage2b-shots.mjs <<'JS'
import { chromium } from 'playwright';
import fs from 'node:fs';
const URL = 'http://localhost:8765/index.html';
const OUT = '.scratch/stage2b';
fs.mkdirSync(OUT, { recursive: true });
const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox'] });

async function run(lang, tag) {
  const errors = [];
  const page = await browser.newPage({ viewport: { width: 960, height: 540 } });
  page.on('console', m => { if (m.type()==='error') errors.push(m.text()); });
  page.on('pageerror', e => errors.push('pageerror: '+e.message));
  if (lang === 'en') await page.addInitScript(() => { try { localStorage.setItem('lumenfall.lang','en'); } catch(e){} });
  await page.goto(URL, { waitUntil: 'load' });
  await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'menu', { timeout: 25000 });
  await page.click('#menu-new');
  await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'cutscene', { timeout: 20000 });
  await new Promise(r=>setTimeout(r,300));
  await page.keyboard.press('Escape');
  await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'play', { timeout: 20000 });
  await new Promise(r=>setTimeout(r,500));

  // L1 title toast
  const toast = await page.evaluate(() => document.getElementById('toast')?.textContent || '');
  await page.screenshot({ path: `${OUT}/${tag}-l1-toast.png` });
  console.log(`${tag} toast: "${toast}"`);

  // walk to the elder
  await page.keyboard.down('ArrowRight');
  await page.waitForFunction(() => window.__lumenfall?.machine?.state === 'story', { timeout: 20000 }).then(()=>true,()=>false);
  await page.keyboard.up('ArrowRight');
  await new Promise(r=>setTimeout(r,1600));
  const d = await page.evaluate(() => {
    const cs = (id) => { const n=document.getElementById(id); const c=getComputedStyle(n); const r=n.getBoundingClientRect();
      return { img:c.backgroundImage.split('/').pop().replace('")',''), w:Math.round(r.width), h:Math.round(r.height),
               panelOpacity:getComputedStyle(document.getElementById('story-panel')).opacity }; };
    return { kael: cs('portrait-kael'), elder: cs('portrait-elder'),
             speaker: document.getElementById('story-speaker').textContent,
             line: document.getElementById('story-line').textContent };
  });
  await page.screenshot({ path: `${OUT}/${tag}-deal-portraits.png` });
  console.log(`${tag} portraits: kael=${d.kael.img}@${d.kael.w}x${d.kael.h} elder=${d.elder.img}@${d.elder.w}x${d.elder.h} panelOpacity=${d.kael.panelOpacity} speaker="${d.speaker}"`);

  // advance to a panel-04 Kael line
  for (let i=0;i<8;i++) {
    await page.keyboard.press('KeyZ'); await new Promise(r=>setTimeout(r,260));
    await page.keyboard.press('KeyZ'); await new Promise(r=>setTimeout(r,520));
    const art = await page.evaluate(() => document.getElementById('story-panel').dataset.art || '');
    const spk = await page.evaluate(() => document.getElementById('story-speaker').textContent);
    if (art === '04' && spk === 'Kael') break;
  }
