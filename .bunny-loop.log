import numpy as np
from PIL import Image
from scipy import ndimage
im = Image.open('assets/statue.jpeg').convert('RGB')
a = np.asarray(im).astype(np.float32)

def flood_mask(a, box, tol=28):
    x0,y0,x1,y1 = box
    sub = a[y0:y1, x0:x1]
    corner = sub[0,0]
    d = np.sqrt(((sub-corner)**2).sum(axis=2))
    near = d <= tol
    lab,n = ndimage.label(near)
    border = set(lab[0,:]) | set(lab[-1,:]) | set(lab[:,0]) | set(lab[:,-1])
    border.discard(0)
    bg = np.isin(lab, list(border)) if border else near
    return ~bg

def runs_of_cols(mask, min_gap=6, min_w=20):
    col = mask.any(axis=0)
    out=[]; s=None; last=None
    for x in range(len(col)):
        if col[x]:
            if s is None: s=x
            last=x
        else:
            if s is not None and x-last>min_gap:
                if last-s>=min_w: out.append((s,last))
                s=None
    if s is not None and last-s>=min_w: out.append((s,last))
    return out

# Section 1 row
m = flood_mask(a,(0,130,1536,396))
r = runs_of_cols(m, min_gap=8, min_w=30)
print('section1 pose column runs:', len(r))
for i,(s,e) in enumerate(r): print('  ',i+1, s, e, 'w',e-s+1)
# section 4 row
m4 = flood_mask(a,(490,740,1020,950))
r4 = runs_of_cols(m4, min_gap=8, min_w=30)
print('section4 runs:', r4)
# damage row
md = flood_mask(a,(1225,740,1536,995))
rd = runs_of_cols(md, min_gap=6, min_w=20)
print('damage runs:', rd)
