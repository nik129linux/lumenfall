import { chromium } from 'playwright';
const b = await chromium.launch({args:['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox']});
const p = await b.newPage({viewport:{width:1280,height:720}});
p.on('pageerror',e=>console.log('[err]',e.message));
await p.goto('http://localhost:8765/index.html',{waitUntil:'load'});
await p.waitForFunction(()=>window.__lumenfall?.machine?.state==='menu',null,{timeout:20000});
const r = await p.evaluate(async ()=>{
  const g=window.__lumenfall;
  document.getElementById('menu-new').click();
  await new Promise(r=>setTimeout(r,300));
  g.cutscene.active=false; g.cutscene.onDone=null; g.beginPlay();
  await new Promise(r=>setTimeout(r,500));
  const W=480,H=270;
  const buf=new Uint8Array(W*H*4);
  g.renderer.readRenderTargetPixels(g.pipeline.target,0,0,W,H,buf);
  const at=(x,y)=>{const i=((H-1-y)*W+x)*4; return [buf[i],buf[i+1],buf[i+2]];};
  // brightest pixel overall
  let best=0,bestPx=null;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=((H-1-y)*W+x)*4; const s=buf[i]+buf[i+1]+buf[i+2]; if(s>best){best=s;bestPx=[x,y,buf[i],buf[i+1],buf[i+2]];}}
  // scan the player's cell region
  const pl=g.player;
  const bx=Math.round(pl.mesh.position.x-g.cam.x), by=Math.round(pl.mesh.position.y-g.cam.y);
  let pbest=0,pbestPx=null;
  for(let y=by-2;y<by+40;y++)for(let x=bx-6;x<bx+30;x++){
    if(x<0||y<0||x>=W||y>=H)continue;
    const i=((H-1-y)*W+x)*4; const s=buf[i]+buf[i+1]+buf[i+2];
    if(s>pbest){pbest=s;pbestPx=[x,y,buf[i],buf[i+1],buf[i+2]];}
  }
  return {brightest:bestPx, playerRegionBrightest:pbestPx, playerBuf:[bx,by],
    u:{levels:pl.sprite.material.userData.uniforms.levels.value, lift:pl.sprite.material.userData.uniforms.gradeLift.value,
       grade:pl.sprite.material.userData.uniforms.grade.value.toArray()},
    vignette:g.pipeline.postUniforms.vignette.value, grain:g.pipeline.postUniforms.grainAmount.value,
    fade:g.pipeline.postUniforms.fade.value};
});
console.log(JSON.stringify(r,null,1));
await b.close();
