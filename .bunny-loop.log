  await new Promise(r=>setTimeout(r,500));
  const pl=g.player, sp=pl.sprite, geo=sp.mesh.geometry;
  const tex=sp.char.texture;
  // project the sprite centre to NDC
  const THREEpos = sp.mesh.position.clone();
  const proj = THREEpos.clone().project(g.pipeline.camera);
  // uv range of the current frame
  const uv=geo.attributes.uv;
  const img=tex.image;
  // check the atlas actually has pixels at the idle frame 0
  const c=document.createElement('canvas'); c.width=img.width;c.height=img.height;
  const ctx=c.getContext('2d'); ctx.drawImage(img,0,0);
  const fr=sp.char.frameRect(0);
  const d=ctx.getImageData(fr.x,fr.y,fr.w,fr.h).data;
  let opaque=0; for(let i=3;i<d.length;i+=4) if(d[i]>128) opaque++;
  return {
    renderInfo:{calls:g.renderer.info.render.calls, tris:g.renderer.info.render.triangles},
    spritePos:THREEpos.toArray().map(Math.round),
    ndc:proj.toArray().map(v=>+v.toFixed(3)),
    inFrustum: proj.x>-1&&proj.x<1&&proj.y>-1&&proj.y<1&&proj.z>-1&&proj.z<1,
    geoBox:{min:geo.boundingBox||null, verts:geo.attributes.position.count},
    uvRect:[uv.getX(0).toFixed(3),uv.getY(0),uv.getX(1).toFixed(3),uv.getY(1)],
    atlasImg:[img.width,img.height], frame0:fr, opaqueInFrame0:opaque,
    matType:sp.mesh.material.type, needsUpdate:sp.mesh.material.needsUpdate,
    programOk: !!sp.mesh.material.program, diag: sp.mesh.material.program?.diagnostics||null,
  };
});
console.log(JSON.stringify(r,null,1));
await b.close();
