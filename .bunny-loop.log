import numpy as np
from PIL import Image
from scipy import ndimage

im = Image.open('assets/statue.jpeg').convert('RGB')
a = np.asarray(im).astype(np.int16)

# flood fill from the border of a crop box, on RGB distance to the corner colour
def flood_key(a, box, tol=28):
    x0,y0,x1,y1 = box
    sub = a[y0:y1, x0:x1]
    corner = sub[0,0].astype(np.int16)
    d = np.sqrt(((sub-corner)**2).sum(axis=2))
    near = d <= tol
    # flood fill the near-background region from the box border
    lab,n = ndimage.label(near)
    border = set(lab[0,:]) | set(lab[-1,:]) | set(lab[:,0]) | set(lab[:,-1])
    border.discard(0)
    bg = np.isin(lab, list(border)) if border else near
    return sub, bg

boxes = {
 'idle1':(5,140,125,392), 'walk1':(505,140,625,392), 'run1':(980,140,1100,392),
 'sweep':(640,760,820,948), 'roots':(840,755,1005,948),
 'hurt':(1235,745,1318,948), 'dead':(1400,800,1508,988),
}
out=[]
for name,bx in boxes.items():
    sub,bg = flood_key(a,bx)
    fg = ~bg
    ys,xs = np.where(fg)
