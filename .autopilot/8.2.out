    orig=Image.open(p).convert('RGB')
    ref=thumb(orig)
    base=orig if orig.width<=1280 else orig.resize((1280,max(1,round(orig.height*1280/orig.width))), Image.LANCZOS)
    for n in (192,96,48,32,24):
        out=base.quantize(colors=n, method=Image.Quantize.FASTOCTREE, dither=Image.Dither.FLOYDSTEINBERG)
        buf=io.BytesIO(); out.save(buf, format='PNG', optimize=True)
        mae=float(np.abs(thumb(out.convert('RGB'))-ref).mean())
        print(f'{name} w={base.width} N={n:3d} {len(buf.getvalue())//1024:5d}KB mae={mae:.1f}')
    print()
