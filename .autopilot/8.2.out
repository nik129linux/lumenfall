#!/usr/bin/env python3
"""Stage 8 asset pipeline: shrink the cutscene panels and the parallax backdrops.

The 19 panels and 3 backgrounds shipped as ~45 MB of 24-bit PNG. Every host that
is not a local disk chokes on that, and the pixel-art look does not need the
weight: the panels are read at most 1280 px wide and the art survives a palette
cut that a 256 px thumbnail cannot see.

Reads the untouched masters from assets-src/ and writes the shrunk PNGs into
assets/. For each image it resizes with LANCZOS so the width is at most 1280
(never upscales, aspect ratio kept), then tries palette sizes from 256 colours
down to 24 and keeps the smallest one whose mean absolute difference against the
master, measured on 256 px-wide LANCZOS thumbnails, stays under the limit.

Usage:
    python3 tools/compress-panels.py            # rewrite assets/ from assets-src/
    python3 tools/compress-panels.py --report   # only print what it would pick
"""

import io
import os
import sys

import numpy as np
from PIL import Image

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SRC = os.path.join(ROOT, "assets-src")
DST = os.path.join(ROOT, "assets")
SCRATCH = os.path.join(ROOT, ".scratch")

MAX_WIDTH = 1280
PALETTES = (192, 160, 128, 96, 64, 48, 32, 24)
MAE_SAFE = 6.0
THUMB_WIDTH = 256
REPORT = "--report" in sys.argv

TARGETS = [(f"cutscenes/{i:02d}.png", 900 * 1024) for i in range(1, 20)] + \
          [(f"bg/l{i}.png", 1400 * 1024) for i in (1, 2, 3)]


def thumb(im):
    w = THUMB_WIDTH
    h = max(1, round(w * im.height / im.width))
    return np.asarray(im.resize((w, h), Image.LANCZOS), dtype=np.float32)


def encode(base, colors):
    out = base.quantize(colors=colors, method=Image.Quantize.FASTOCTREE,
                        dither=Image.Dither.FLOYDSTEINBERG)
    buf = io.BytesIO()
    out.save(buf, format="PNG", optimize=True)
    return out, buf.getvalue()


def shrink(src_path, limit):
    original = Image.open(src_path).convert("RGB")
    ref = thumb(original)
    if original.width > MAX_WIDTH:
        w = MAX_WIDTH
        h = max(1, round(original.height * w / original.width))
        base = original.resize((w, h), Image.LANCZOS)
    else:
        base = original
    fallback = None
    for colors in PALETTES:
        out, data = encode(base, colors)
        mae = float(np.abs(thumb(out.convert("RGB")) - ref).mean())
        if mae > MAE_SAFE:
            continue
        if len(data) <= limit:
            return original.size, base.size, (colors, mae, data)
        if fallback is None or len(data) < len(fallback[2]):
            fallback = (colors, mae, data)
    return original.size, base.size, fallback


def main():
    os.makedirs(SCRATCH, exist_ok=True)
    failures = []
    panel_total = 0
    total = 0
    for rel, limit in TARGETS:
        src_path = os.path.join(SRC, rel)
        dst_path = os.path.join(DST, rel)
        if not os.path.exists(src_path):
            failures.append(f"{rel}: missing master {src_path}")
            continue
        os.makedirs(os.path.dirname(dst_path), exist_ok=True)
        osize, rsize, best = shrink(src_path, limit)
        if best is None:
            failures.append(f"{rel}: no palette kept mae <= {MAE_SAFE}")
            continue
        colors, mae, data = best
        total += len(data)
        if rel.startswith("cutscenes/"):
            panel_total += len(data)
        if len(data) > limit:
            failures.append(f"{rel}: {len(data)/1024:.0f} KB over the {limit/1024:.0f} KB limit")
        print(f"{rel:22s} {osize[0]}x{osize[1]} -> {rsize[0]}x{rsize[1]} "
              f"colors={colors:3d} mae={mae:4.1f} {len(data)/1024:7.1f} KB "
              f"(limit {limit/1024:.0f} KB)")
        if REPORT:
            continue
        tmp = os.path.join(SCRATCH, os.path.basename(rel) + ".tmp")
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, dst_path)
    print(f"panels {panel_total/1024/1024:.2f} MB (budget 9.00 MB), "
          f"with backgrounds {total/1024/1024:.2f} MB")
    if panel_total > 9 * 1024 * 1024:
        failures.append(f"panels total {panel_total/1024/1024:.2f} MB over the 9 MB budget")
    for f in failures:
        print("FAIL  " + f)
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
