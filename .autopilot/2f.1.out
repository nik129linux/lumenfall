import json
from PIL import Image
m = json.load(open('sprites/manifest.json'))
def cell(name, clip, i):
    d = m[name]; cw, ch = d['cell']
    x = d['frames'][[c for c,_ in d['frames']].index(clip)][1][i][0]
    a = Image.open(f'sprites/{name}.png')
    return a.crop((x, 0, x+cw, ch)).resize((cw*7, ch*7), Image.NEAREST)
# previously failing: wisp/float[2], wisp/dash[2], crawler/walk[2], crawler/lunge[2], spitter/walk[1], spitter/hurt[0]
tiles = [
    cell('wisp','float',2), cell('wisp','dash',2),
    cell('crawler','walk',2), cell('crawler','lunge',2),
    cell('spitter','walk',1), cell('spitter','hurt',0),
]
w = max(t.width for t in tiles); h = max(t.height for t in tiles)
out = Image.new('RGBA', (w*3+20, h*2+10), (128,128,128,255))
for i,t in enumerate(tiles):
    out.paste(t, ((i%3)*(w+10), (i//3)*(h+10)))
out.save('.scratch/zoom-failing.png')
print('saved', out.size)
