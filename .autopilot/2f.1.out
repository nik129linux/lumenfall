[0m$ [0mcd "/home/nico/Documents/U/Co/U/4s/courses/interfaces/tareas/proyecto final/juego" && cat > .scratch/inspect.py <<'EOF'
import sys, os
sys.path.insert(0, 'tools')
import cut_minions as cm
from PIL import Image
import numpy as np

# Crawler sheet colors
im = Image.open('assets/crawler.png').convert('RGB')
W, H = im.size
print(f'crawler sheet {W}x{H}')
a = np.asarray(im)
print('corners:', a[0,0], a[0,-1], a[-1,0], a[-1,-1])
print('center:', a[H//2, W//2])
# sample some background points
for (x,y) in [(5,5),(W-5,5),(5,H-5),(W-5,H-5),(W//2,5),(5,H//2)]:
    print(f'  ({x},{y}) = {a[y,x]}')
# brightness stats
mx = a.max(axis=2); mn = a.min(axis=2)
sat = np.where(mx==0, 0, (mx-mn)/np.maximum(mx,1))
print('brightness: min', mx.min(), 'max', mx.max(), 'mean', round(mx.mean(),1))
print('near-black (mx<60) frac:', round((mx<60).mean(),3))
print('low-sat (sat<0.2) frac:', round((sat<0.2).mean(),3))
print('near-black AND low-sat frac:', round(((mx<60)&(sat<0.2)).mean(),3))
# how much of the border is near-black low-sat?
border = np.concatenate([mx[0,:], mx[-1,:], mx[:,0], mx[:,-1]])
print('border near-black frac:', round((border<60).mean(),3))
EOF
