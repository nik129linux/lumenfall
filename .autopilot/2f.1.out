[0m$ [0mcd "/home/nico/Documents/U/Co/U/4s/courses/interfaces/tareas/proyecto final/juego" && mkdir -p .scratch && cat > .scratch/analyze2f.py <<'EOF'
import json, numpy as np
from PIL import Image
from scipy import ndimage
m = json.load(open('sprites/manifest.json'))
for name, d in m.items():
    if name == 'spitterShot' or 'frames' not in d: continue
    a = np.asarray(Image.open(f'sprites/{name}.png').convert('RGBA'))[:, :, 3] > 40
    cw, ch = d['cell']
    clips = d['frames']; items = clips.items() if isinstance(clips, dict) else clips
    for clip, cells in items:
        if clip.startswith('dead'): continue
        for i, (x, y) in enumerate(cells):
            f = a[y:y+ch, x:x+cw]
            if f.sum() == 0: continue
            lab, k = ndimage.label(f, structure=np.ones((3,3)))
            sizes = ndimage.sum(f, lab, range(1, k+1))
            order = np.argsort(sizes)[::-1]
            main = sizes[order[0]]
            extra = f.sum() - main
            if extra / f.sum() > 0.05:
                print(f'{name}/{clip}[{i}] cell {cw}x{ch} total {f.sum()} main {main} extra {extra} ({extra/f.sum():.0%}) ncomp {k}')
                for oi in order[1:6]:
                    sz = int(sizes[oi])
                    if sz < 3: continue
                    ys, xs = np.where(lab == oi+1)
                    print(f'    comp {oi+1}: {sz}px bbox x[{xs.min()}-{xs.max()}] y[{ys.min()}-{ys.max()}]')
EOF
