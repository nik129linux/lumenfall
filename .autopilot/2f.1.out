[0m$ [0mcd "/home/nico/Documents/U/Co/U/4s/courses/interfaces/tareas/proyecto final/juego" && cat > .scratch/boxes.py <<'EOF'
import sys, os
sys.path.insert(0, 'tools')
import cut_minions as cm
from PIL import Image

for name in ('wisp', 'crawler', 'spitter'):
    src = os.path.join(cm.ROOT, cm.SOURCES[name])
    im = Image.open(src).convert('RGB')
    W, H = im.size
    px = im.load()
    flat = [px[x, y] for y in range(H) for x in range(W)]
    alpha = (cm.magenta_alpha(flat) if name != 'crawler' else cm.local_contrast_alpha(im, W, H))
    solid = [[alpha[y * W + x][0] > 0.5 for x in range(W)] for y in range(H)]
    if name != 'crawler':
        solid = cm.erode(solid, W, H, 1)
    sep = [sum(1 for x in range(W) if solid[y][x]) < W * 0.02 for y in range(H)]
    rows = cm.bands([not f for f in sep], W, H)
    rows = [r for r in rows if r[1] - r[0] > H * 0.05]
    weight = lambda r: sum(1 for y in range(r[0], r[1] + 1) for x in range(W) if solid[y][x])
    top = max(weight(r) for r in rows)
    rows = [r for r in rows if weight(r) > top * 0.15]
    print(f'{name}: {W}x{H} rows={rows}')
    for (y0, y1) in rows:
        colflags = [all(not solid[y][x] for y in range(y0, y1 + 1)) for x in range(W)]
        boxes_row = cm.merge_fragments(cm.split_row(colflags))
        print(f'  row y[{y0}-{y1}]: {boxes_row}')
        # content extent per box (ignoring box edges)
        for (x0, x1) in boxes_row:
            xs = [x for x in range(x0, x1+1) if any(solid[y][x] for y in range(y0, y1+1))]
            ys = [y for y in range(y0, y1+1) if any(solid[y][x] for x in range(x0, x1+1))]
            if xs:
                print(f'    box x[{x0}-{x1}] content x[{min(xs)}-{max(xs)}] y[{min(ys)}-{max(ys)}]')
EOF
