import sys, os
sys.path.insert(0, 'tools')
import cut_minions as cm

name = 'wisp'
im, W, H, frames, shot_box = cm.cut(name)
print(f'{name}: {len(frames)} frames')
for i, (fx, fy, a) in enumerate(frames):
    print(f'  frame {i}: origin ({fx},{fy}) size {len(a[0])}x{len(a)}')
xs = [f[0] for f in frames]; ys = [f[1] for f in frames]
rights = [f[0] + len(f[2][0]) for f in frames]; bots = [f[1] + len(f[2]) for f in frames]
cx0, cy0 = min(xs), min(ys)
cw, ch = max(rights) - cx0, max(bots) - cy0
print(f'cell would be {cw}x{ch}, cx0={cx0} cy0={cy0}')
EOF
