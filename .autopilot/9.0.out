  // ------------------------------------------------------------------ flow
  startRun(hasSave) {
    audio.resume();
    this.hp = HP_PER_LEVEL;
    this.ember = 0;
    this.levelIndex = 0;
    this.runSeconds = 0;
    this.runDeaths = 0;
