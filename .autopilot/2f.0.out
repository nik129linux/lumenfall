[0m$ [0mcat > .scratch/stage2f/masktest.py <<'EOF'
import sys
import numpy as np
from PIL import Image
from scipy import ndimage
sys.path.insert(0,'tools')
import cut_minions as cm

def bg_alpha(arr, luma_t, sat_t):
    """near-black low-saturation background, flood filled from the borders."""
    rgb = arr[...,:3].astype(np.int32)
    mx = rgb.max(-1); mn = rgb.min(-1)
    sat = np.where(mx>0, (mx-mn)/np.maximum(mx,1), 0.0)
    bgish = (mx <= luma_t) & (sat <= sat_t)
    free = np.zeros_like(bgish)
    border = np.zeros_like(bgish); border[0,:]=border[-1,:]=True; border[:,0]=border[:,-1]=True
    free[border & bgish] = True
    # iterative dilate within bgish
    while True:
        nxt = ndimage.binary_dilation(free) & bgish
        if nxt.sum()==free.sum(): break
        free = nxt
    return ~free

arr = np.asarray(Image.open('assets/crawler.png'))
for luma_t, sat_t in ((40,0.45),(48,0.5),(56,0.5),(64,0.55)):
    solid = bg_alpha(arr, luma_t, sat_t)
    lab,k = ndimage.label(solid, structure=np.ones((3,3)))
    sizes = np.bincount(lab.ravel())[1:]
    big = sizes[sizes>2000]
    print(f'luma<={luma_t} sat<={sat_t}: sheet px={solid.sum()} comps={k} big={sorted(big)[-4:]} nbig={len(big)}')
EOF
