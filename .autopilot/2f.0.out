[0m$ [0mcat > .scratch/stage2f/look.py <<'EOF'
import sys
import numpy as np
from PIL import Image, ImageDraw
sys.path.insert(0,'tools')
import cut_minions as cm

def get(name):
    im=Image.open(cm.SOURCES[name]).convert('RGB'); W,H=im.size; px=im.load()
    flat=[px[x,y] for y in range(H) for x in range(W)]
    alpha=cm.magenta_alpha(flat) if name!='crawler' else cm.local_contrast_alpha(im,W,H)
    solid=[[alpha[y*W+x][0]>0.5 for x in range(W)] for y in range(H)]
    if name!='crawler': solid=cm.erode(solid,W,H,1)
    sep=[sum(1 for x in range(W) if solid[y][x])<W*0.02 for y in range(H)]
    rows=cm.bands([not f for f in sep],W,H); rows=[r for r in rows if r[1]-r[0]>H*0.05]
    w=lambda r: sum(1 for y in range(r[0],r[1]+1) for x in range(W) if solid[y][x])
    top=max(w(r) for r in rows); rows=[r for r in rows if w(r)>top*0.15]
    boxes=[]
    for (y0,y1) in rows:
        colf=[all(not solid[y][x] for y in range(y0,y1+1)) for x in range(W)]
        for (x0,x1) in cm.merge_fragments(cm.split_row(colf)):
            if (x1-x0)>W*0.01 and (y1-y0)>H*0.05: boxes.append((x0,y0,x1,y1))
    return im,W,H,boxes,solid

for name in ('wisp','crawler','spitter'):
    im,W,H,boxes,solid=get(name)
    S=np.array(solid)
    # overlay boxes on the source
    ov=im.copy().resize((W//3,H//3),Image.LANCZOS); d=ImageDraw.Draw(ov)
    for (x0,y0,x1,y1) in boxes:
        d.rectangle([x0//3,y0//3,x1//3,y1//3],outline=(255,0,0),width=2)
    ov.save(f'.scratch/stage2f/ov-{name}.png')
    # masked crops on grey
    Z=2; cols=6
    cw=max(b[2]-b[0]+1 for b in boxes); chh=max(b[3]-b[1]+1 for b in boxes)
    rows_n=(len(boxes)+cols-1)//cols
    out=Image.new('RGBA',(cols*(cw//Z+2), rows_n*(chh//Z+12)),(128,128,128,255)); dd=ImageDraw.Draw(out)
    for i,(x0,y0,x1,y1) in enumerate(boxes):
        a=np.asarray(im.crop((x0,y0,x1+1,y1+1)),dtype=np.float64)/255
        al=np.array([[solid[y][x] for x in range(x0,x1+1)] for y in range(y0,y1+1)])
        tile=a.copy(); tile[...,3]=al
        t=Image.fromarray((tile*255).astype(np.uint8),'RGBA').resize(((x1-x0+1)//Z,(y1-y0+1)//Z),Image.BOX)
        px_=(i%cols)*(cw//Z+2); py=(i//cols)*(chh//Z+12)+10
        out.paste(t,(px_,py),t); dd.text((px_,py-9),f'{i} x{x0}-{x1}',fill=(255,255,255,255))
    out.save(f'.scratch/stage2f/boxes-{name}.png')
print('ok')
EOF
