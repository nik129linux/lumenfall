import json
import numpy as np
from PIL import Image
from scipy import ndimage
m=json.load(open('sprites/manifest.json'))
for name,d in m.items():
    if 'frames' not in d: continue
    a=np.asarray(Image.open(f'sprites/{name}.png').convert('RGBA'))[:,:,3]>40
    cw,ch=d['cell']
    print(f'== {name} cell {cw}x{ch}')
    for clip,cells in d['frames']:
        for i,(x,y) in enumerate(cells):
            f=a[y:y+ch,x:x+cw]
            lab,k=ndimage.label(f,structure=np.ones((3,3)))
            sizes=ndimage.sum(f,lab,range(1,k+1))
            o=np.argsort(sizes)[::-1]
            tot=f.sum()
            parts=[]
            for j in o[:3]:
                ys,xs=np.where(lab==j+1)
                parts.append(f'{int(sizes[j])}px x{xs.min()}-{xs.max()} y{ys.min()}-{ys.max()}')
            print(f'  {clip}[{i}] @x{x} tot={tot} k={k} | '+' ; '.join(parts))
