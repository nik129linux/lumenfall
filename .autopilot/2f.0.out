[0m$ [0mcat > .scratch/stage2f/packdbg.py <<'EOF'
import sys
import numpy as np
from PIL import Image
sys.path.insert(0,'tools')
import cut_minions as cm

orig_pack = cm.pack
def dbg(name, frames, display_h):
    xs=[f[0] for f in frames]; ys=[f[1] for f in frames]
    rights=[f[0]+len(f[2][0]) for f in frames]; bots=[f[1]+len(f[2]) for f in frames]
    cx0,cy0=min(xs),min(ys); cw,ch=max(rights)-cx0,max(bots)-cy0
    th=display_h*2; k=ch/th; tw=max(1,round(cw/k))
    print(f'{name}: box origin ({cx0},{cy0}) cw={cw} ch={ch} k={k:.2f} cell {tw}x{th}')
    for i,(fx,fy,a,rgb) in enumerate(frames):
        fh,fw=len(a),len(a[0])
        # where the content sits inside its own tile
        solid=np.array(a)>0.5
        ys_,xs_=np.where(solid) if solid.any() else (np.array([0]),np.array([0]))
        print(f'  f{i} box=({fx},{fy}) size {fw}x{fh} local content x{xs_.min()}-{xs_.max()} y{ys_.min()}-{ys_.max()}'
              f' -> paste at cell x={i*tw}+{round((fx-cx0)/k)}')
    return orig_pack(name, frames, display_h)
cm.pack=dbg
cm.main()
EOF
