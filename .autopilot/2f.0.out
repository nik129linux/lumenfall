[0m$ [0mmkdir -p .scratch/stage2f && cat > .scratch/stage2f/probe.py <<'EOF'
import json, os, sys
import numpy as np
from PIL import Image
sys.path.insert(0, 'tools')
import cut_minions as cm

for name in ('wisp','crawler','spitter'):
    im = Image.open(cm.SOURCES[name]).convert('RGB')
    W,H = im.size
    px = im.load()
    flat=[px[x,y] for y in range(H) for x in range(W)]
    alpha = cm.magenta_alpha(flat) if name!='crawler' else cm.local_contrast_alpha(im,W,H)
    solid=[[alpha[y*W+x][0]>0.5 for x in range(W)] for y in range(H)]
    if name!='crawler':
        solid=cm.erode(solid,W,H,1)
    sep=[sum(1 for x in range(W) if solid[y][x])<W*0.02 for y in range(H)]
    rows=cm.bands([not f for f in sep],W,H)
    rows=[r for r in rows if r[1]-r[0]>H*0.05]
    w=lambda r: sum(1 for y in range(r[0],r[1]+1) for x in range(W) if solid[y][x])
    top=max(w(r) for r in rows)
    rows=[r for r in rows if w(r)>top*0.15]
    print(f'== {name} {W}x{H} rows={rows}')
    boxes=[]
    for (y0,y1) in rows:
        colf=[all(not solid[y][x] for y in range(y0,y1+1)) for x in range(W)]
        br=cm.merge_fragments(cm.split_row(colf))
        got=[(x0,y0,x1,y1) for (x0,x1) in br if (x1-x0)>W*0.01 and (y1-y0)>H*0.05]
        boxes+=got
        print(f'  row {y0}-{y1} n={len(got)}:')
        for (x0,_,x1,_) in got:
            n=sum(1 for y in range(y0,y1+1) for x in range(x0,x1+1) if solid[y][x])
            print(f'     x {x0}-{x1} w={x1-x0+1} solid={n}')
    print('  total', len(boxes))
EOF
