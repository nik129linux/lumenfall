import json, sys
import numpy as np
from PIL import Image, ImageDraw
m=json.load(open('sprites/manifest.json'))
for name in ('wisp','crawler','spitter'):
    d=m[name]; cw,ch=d['cell']; im=Image.open(f'sprites/{name}.png').convert('RGBA')
    Z=6
    out=Image.new('RGBA',(cw*Z*6+40, (ch*Z+14)*4+20),(128,128,128,255))
    dr=ImageDraw.Draw(out)
    for r,(clip,cells) in enumerate(d['frames']):
        for i,(x,y) in enumerate(cells):
            c=im.crop((x,y,x+cw,y+ch)).resize((cw*Z,ch*Z),Image.NEAREST)
            px=(i%6)*(cw*Z+6)+4; py=r*(ch*Z+14)+12
            out.paste(c,(px,py),c)
            dr.text((px,py-10),f'{clip}{i}',fill=(255,255,255,255))
    out.save(f'.scratch/stage2f/atlas-{name}.png')
print('ok')
EOF
